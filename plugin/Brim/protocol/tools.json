{
  "tools": [
    {
      "name": "apply_changes",
      "description": "Apply an ordered batch of concrete operations to the slicer. Stops at the first failing operation and reports what was applied.",
      "input_schema": {
        "type": "object",
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "select_mode",
                    "select_profile",
                    "select_material",
                    "set_global_setting",
                    "set_extruder_setting",
                    "reset_overrides",
                    "import_model",
                    "open_3mf",
                    "transform",
                    "duplicate",
                    "arrange",
                    "delete",
                    "save_profile"
                  ],
                  "description": "Operation kind. Required fields by kind: select_mode(mode); select_profile(profile_id); select_material(material_id, extruder); set_global_setting(key, value); set_extruder_setting(key, value, extruder); reset_overrides(keys); import_model(path); open_3mf(path, import_as); transform(object_id, frame, and at least one of position_mm, rotation_deg, scale; rotation_center when rotation_deg is set); duplicate(object_id, count); arrange(object_ids optional); delete(object_ids); save_profile(name)."
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "classic",
                    "cylindrical",
                    "cylindrical_full"
                  ]
                },
                "profile_id": {
                  "type": "string"
                },
                "material_id": {
                  "type": "string"
                },
                "extruder": {
                  "type": "integer",
                  "minimum": 0
                },
                "key": {
                  "type": "string"
                },
                "value": {
                  "description": "New setting value in the unit reported by search_settings."
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "path": {
                  "type": "string",
                  "description": "Local path of an attached model file from the context attachments list."
                },
                "import_as": {
                  "type": "string",
                  "enum": [
                    "restore_project",
                    "import_geometry"
                  ]
                },
                "object_id": {
                  "type": "string"
                },
                "object_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "frame": {
                  "type": "string",
                  "enum": [
                    "scene"
                  ],
                  "description": "Coordinate frame. scene: build-plate frame in millimetres, origin at the plate center, x right, y back, z up. Position is the bounding-box center."
                },
                "position_mm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Absolute position in millimetres."
                },
                "rotation_deg": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Absolute orientation relative to the imported orientation: extrinsic X-Y-Z Euler angles in degrees about build-plate axes."
                },
                "scale": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Absolute scale factors relative to the imported size, applied along the object's local axes; prefer a uniform scale."
                },
                "rotation_center": {
                  "type": "string",
                  "enum": [
                    "bbox_center",
                    "origin",
                    "bbox_bottom_center"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "explanation": {
            "type": "string",
            "description": "Short reason for the batch, shown to the user on the confirmation card."
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "search_settings",
      "description": "Search available slicer settings with types, units, constraints and current values.",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "inspect_profile",
      "description": "Selected profile, available quality types, custom profiles and user overrides. Current values of all enabled settings are in the context.",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "inspect_material",
      "description": "Facts from the material description in the slicer.",
      "input_schema": {
        "type": "object",
        "properties": {
          "material_id": {
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "inspect_scene",
      "description": "Current scene state after changes: printer, mode, profile, materials, overrides, objects with positions and sizes, slice state and errors.",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "analyze_geometry",
      "description": "Numeric geometry analysis of selected objects with units and method limits.",
      "input_schema": {
        "type": "object",
        "required": [
          "object_ids"
        ],
        "properties": {
          "object_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "direction": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Build direction in scene coordinates."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "render_scene",
      "description": "Render an additional image of the scene from a chosen view.",
      "input_schema": {
        "type": "object",
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "iso",
              "front",
              "back",
              "left",
              "right",
              "top",
              "bottom"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "slice",
      "description": "Slice the current scene and save G-code and 3MF into the chat folder.",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "read_document",
      "description": "Read an attached document as text: DOCX (headings, lists, tables as Markdown, embedded images returned as images), XLSX (sheets as Markdown tables), CSV/TSV, TXT, MD, JSON, PDF (text layer only; scanned PDFs report an error). Long text is paged: repeat with start = next_start.",
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Local path of a document attachment from the context attachments list."
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "description": "Character offset to continue from (next_start of the previous call)."
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000,
            "description": "Characters to return, default 20000."
          },
          "sheet": {
            "type": "string",
            "description": "XLSX: one sheet name; all sheets by default."
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "XLSX/CSV: [first, last] 1-based row range; the header row is always kept."
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "PDF: [first, last] 1-based page range."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "load_skill",
      "description": "Load the instructions of a skill from the skill catalog in the context. Load the skill that fits the user's task before acting; follow its instructions for the rest of the task.",
      "input_schema": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name from the catalog."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "lookup_defect",
      "description": "Print defect guide: find defects by a description in Russian or English (or by id) and get their causes, the slicer settings that fix them with direction and a typical step, and the current values of those settings. Settings the slicer does not have are listed in unknown_keys.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "What the user sees, e.g. 'нитки между деталями' or 'holes in the outer wall'."
          },
          "defect_id": {
            "type": "string",
            "enum": [
              "stringing",
              "zits_blobs",
              "wall_gaps",
              "under_extrusion",
              "over_extrusion",
              "first_layer_squish",
              "poor_adhesion",
              "warping",
              "layer_separation",
              "overhang_sag",
              "rough_surface",
              "layer_shift",
              "dimension_error",
              "moisture",
              "top_surface_holes"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    }
  ]
}
