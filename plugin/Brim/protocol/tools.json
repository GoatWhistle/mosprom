{
  "contract_version": "2",
  "tools": [
    {
      "name": "apply_changes",
      "description": "Apply an ordered batch of concrete operations to the slicer. Stops at the first failing operation and reports what was applied.",
      "input_schema": {
        "type": "object",
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "select_mode",
                    "select_profile",
                    "select_material",
                    "set_global_setting",
                    "set_extruder_setting",
                    "reset_overrides",
                    "import_model",
                    "open_3mf",
                    "transform",
                    "duplicate",
                    "arrange",
                    "delete",
                    "save_profile"
                  ],
                  "description": "Operation kind. Required fields by kind: select_mode(mode); select_profile(profile_id); select_material(material_id, extruder); set_global_setting(key, value); set_extruder_setting(key, value, extruder); reset_overrides(keys); import_model(attachment_id); open_3mf(attachment_id, import_as); transform(object_id, frame, and at least one of position_mm, rotation_deg, scale; rotation_center when rotation_deg is set); duplicate(object_id, count); arrange(object_ids optional); delete(object_ids); save_profile(name)."
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "classic",
                    "cylindrical",
                    "cylindrical_full"
                  ]
                },
                "profile_id": {
                  "type": "string"
                },
                "material_id": {
                  "type": "string"
                },
                "extruder": {
                  "type": "integer",
                  "minimum": 0
                },
                "key": {
                  "type": "string"
                },
                "value": {
                  "description": "New setting value in the unit reported by search_settings."
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "attachment_id": {
                  "type": "string"
                },
                "import_as": {
                  "type": "string",
                  "enum": [
                    "restore_project",
                    "import_geometry"
                  ]
                },
                "object_id": {
                  "type": "string"
                },
                "object_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "frame": {
                  "type": "string",
                  "enum": [
                    "scene"
                  ],
                  "description": "Coordinate frame. scene: build-plate frame in millimetres, origin at the plate center, x right, y back, z up. Position is the bounding-box center."
                },
                "position_mm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Absolute position in millimetres."
                },
                "rotation_deg": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Absolute orientation relative to the imported orientation: extrinsic X-Y-Z Euler angles in degrees about build-plate axes."
                },
                "scale": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Absolute scale factors relative to the imported size, applied along the object's local axes; prefer a uniform scale."
                },
                "rotation_center": {
                  "type": "string",
                  "enum": [
                    "bbox_center",
                    "origin",
                    "bbox_bottom_center"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "explanation": {
            "type": "string",
            "description": "Short reason for the batch, shown to the user in ask mode."
          }
        }
      }
    },
    {
      "name": "search_settings",
      "description": "Search available slicer settings with types, units, constraints and current values.",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "inspect_profile",
      "description": "Selected profile, available quality types, custom profiles and user overrides. Current values of all enabled settings are in the scene context.",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "inspect_material",
      "description": "Facts from the material description in the slicer.",
      "input_schema": {
        "type": "object",
        "properties": {
          "material_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "analyze_geometry",
      "description": "Numeric geometry analysis of selected objects with units and method limits.",
      "input_schema": {
        "type": "object",
        "required": [
          "object_ids"
        ],
        "properties": {
          "object_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "direction": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Build direction in scene coordinates."
          }
        }
      }
    },
    {
      "name": "render_scene",
      "description": "Render an additional image of the scene from a chosen view.",
      "input_schema": {
        "type": "object",
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "iso",
              "front",
              "back",
              "left",
              "right",
              "top",
              "bottom"
            ]
          }
        }
      }
    },
    {
      "name": "slice",
      "description": "Slice the current scene and save G-code and 3MF automatically.",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "ask_user",
      "description": "Ask the user questions (free-text answers) and wait. With an empty questions list and a requirements_summary, declare that requirements are sufficient and unlock changes and slicing.",
      "input_schema": {
        "type": "object",
        "required": [
          "questions"
        ],
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "requirements_summary": {
            "type": "string"
          }
        }
      }
    }
  ]
}
